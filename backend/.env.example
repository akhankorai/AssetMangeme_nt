DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=sqlserver_compat
DB_NAME=AssetManagement
DB_HOST=localhost
DB_INSTANCE=SQLEXPRESS
DB_PORT=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_EXTRA_PARAMS=Encrypt=no;TrustServerCertificate=yes
DB_USER=
DB_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BOOTSTRAP_ADMIN_ON_MIGRATE=True
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_FORCE_PASSWORD_RESET=False
